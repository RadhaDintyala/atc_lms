# ─── Server Configuration (Render) ───────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# REQUIRED: Change this to a long random string before deploying!
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-secure-random-secret-minimum-32-chars

# ─── CORS — Vercel Frontend URL ───────────────────────────────────────────────
# Set this to your Vercel deployment URL (no trailing slash)
# e.g. https://atc-lms.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ─── Persistent Storage (Render Disk) ─────────────────────────────────────────
# Only set if you added a Render Disk. Leave blank for ephemeral storage.
# DB_PATH=/data/db.json

# ─── Google Gemini API (optional — only needed for AI features) ───────────────
# GEMINI_API_KEY=your-gemini-api-key-here

# ─── Frontend (Vercel) env vars — set these in the Vercel dashboard ───────────
# VITE_API_BASE_URL=https://atc-lms-api.onrender.com/api
