# ─── Server Configuration (Render Backend) ──────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Database Configuration (MongoDB Atlas) ──────────────────────────────────
# REQUIRED for persistence on Render free tier.
# Paste your MongoDB Atlas connection string here (replace <password> with your DB password):
MONGO_URI=mongodb+srv://dintyalaradhakalyani_db_user:<password>@cluster0.jg0yj9a.mongodb.net/atc_lms?retryWrites=true&w=majority

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# REQUIRED: Change this to a long random secret in production
JWT_SECRET=replace-this-with-a-secure-random-secret-minimum-32-chars

# ─── CORS — Vercel Frontend URL ───────────────────────────────────────────────
# Set this in Render to your Vercel deployment URL (no trailing slash)
# e.g. https://atc-lms.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ─── Google Gemini API (optional — only needed for AI features) ───────────────
# GEMINI_API_KEY=your-gemini-api-key-here

# ─── Frontend (Vercel) Environment Variables ──────────────────────────────────
# In your Vercel Project Settings -> Environment Variables, add:
# VITE_API_BASE_URL=https://atc-lms-api.onrender.com/api
