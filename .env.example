# ─── Server Configuration ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# Replace <db_password> with your Atlas database user password
MONGO_URI=mongodb+srv://dintyalaradhakalyani_db_user:<db_password>@cluster0.blxmown.mongodb.net/atc_lms?retryWrites=true&w=majority

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars

# ─── CORS — Vercel Frontend URL ───────────────────────────────────────────────
# Set to your Vercel deployment URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# ─── Vercel Frontend Environment Variable ────────────────────────────────────
# Add this in your Vercel Project Settings → Environment Variables:
# VITE_API_BASE_URL=https://your-render-service.onrender.com/api

# ─── Google Gemini AI (optional) ─────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here

